    Conn["Connector 扩展注册的工具"]
  end

  Front -- "第 1 步: 看着清单上的名字调 SearchTools('github create_issue')<br/>取回该工具的 toolRef 与 JSON 参数格式" --> Dynamic
  Front -- "第 2 步: 调 ExecuteTool(toolRef, input)<br/>内部还原为真实工具并走权限审批" --> Dynamic
