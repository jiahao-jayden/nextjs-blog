{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node .wehub/scripts/wehub.cjs task list --digest",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node .wehub/scripts/wehub.cjs task list --digest",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .wehub/scripts/wehub.cjs task list --digest",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .wehub/scripts/wehub.cjs task list --brief",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
